# ==============================================================================
# Environment Configuration Template for NER Microservice
# ==============================================================================
# Copy this file to .env for local overrides:
#   cp .env.example .env
# ==============================================================================

# Filesystem path to the local model directory containing weights and configs
# Default: model
MODEL_PATH=model

# Service port (default for uvicorn: 8000)
PORT=8000

# Service host binding (0.0.0.0 for Docker containers, 127.0.0.1 for local dev)
HOST=0.0.0.0
